# Clerk publishable key. Public by design, but it picks the Clerk instance.
# Use the development key for tests. Use the production key only after the
# production Clerk instance exists and the API in Render uses the same instance.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# wellipay-api. Defaults to https://wellipay-api.onrender.com when unset.
# Set it for a local API, for example http://192.168.1.10:10000
EXPO_PUBLIC_WELLIPAY_API_URL=https://wellipay-api.onrender.com

# The guest payment page that payment links open.
# Defaults to https://wellipaypro.onrender.com/pay.html when unset.
EXPO_PUBLIC_PAY_PAGE_URL=https://wellipaypro.onrender.com/pay.html
