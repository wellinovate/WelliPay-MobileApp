{
  "expo": {
    "name": "WelliPay",
    "slug": "wellipay-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.wellipay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow WelliPay to access your camera to scan hospital bills and QR codes.",
        "NSFaceIDUsageDescription": "Allow WelliPay to use Face ID for fast and secure account unlock and payment authorization."
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.wellipay.app",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WelliPay to access your camera to scan hospital bills and QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow WelliPay to use Face ID for fast and secure account unlock and payment authorization."
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "scheme": "wellipay",
    "extra": {
      "eas": {
        "projectId": "86c77d15-2b7c-46e9-afbe-9cba73c4939e"
      }
    },
    "owner": "talk2jaywin"
  }
}
